# Kopiér denne fil til .env.local og udfyld værdierne.
# Se README.md for hvordan du finder dem i Supabase.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din-anon-public-key

# Adgangskode Lars bruger for at låse redigering op på /overblik.
# OBS: Dette er IKKE rigtig sikkerhed (se README) - bare en simpel spærre
# mod at besætningen roder i sejladser/besætningsliste ved et uheld.
NEXT_PUBLIC_LARS_CODE=skift-mig
